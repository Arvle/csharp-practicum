# Локальный запуск через docker compose
DOMAIN=localhost
APP_ENV=development

POSTGRES_DB=csharppracticum
POSTGRES_USER=csharp_admin
POSTGRES_PASSWORD=csharp_local_password_2026

JWT_SECRET=CHANGE_ME_64_BYTES_HEX_SECRET
JWT_EXPIRATION_HOURS=24
TEACHER_SETUP_TOKEN=local_teacher_setup_2026

ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:5173,http://127.0.0.1:5173,https://localhost,https://127.0.0.1
ALLOWED_WS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:5173,http://127.0.0.1:5173,https://localhost,https://127.0.0.1

RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=100
REQUEST_TIMEOUT_SECONDS=600
READ_TIMEOUT_SECONDS=30
WRITE_TIMEOUT_SECONDS=600
IDLE_TIMEOUT_SECONDS=600
COMPILER_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_MB=10

UPLOAD_DIR=/home/appuser/uploads
COMPILER_SANDBOX=0
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

VITE_API_URL=/api
VITE_WS_URL=
VITE_API_TIMEOUT=30000
VITE_APP_NAME=C# Практикум
VITE_APP_VERSION=1.0.0
VITE_TOKEN_KEY=csharp_practicum_token
VITE_USER_KEY=csharp_practicum_user
