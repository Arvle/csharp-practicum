# Локальный запуск backend без Docker
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://csharp_admin:csharp_local_password_2026@localhost:5432/csharppracticum?sslmode=disable
UPLOAD_DIR=./uploads

JWT_SECRET=CHANGE_ME_64_BYTES_HEX_SECRET
